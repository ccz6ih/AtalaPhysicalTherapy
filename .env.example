# ── Lead delivery (forms) ─────────────────────────────────────────────
# SiteGround mailbox SMTP (Site Tools → Email → Accounts → Mail Configuration)
SMTP_HOST=mail.atalaphysicaltherapy.com
SMTP_PORT=465
SMTP_USER=contact@atalaphysicaltherapy.com
SMTP_PASS=
# Where leads go, and the From address (must be the SMTP account or an allowed alias)
LEAD_TO=contact@atalaphysicaltherapy.com
LEAD_FROM=contact@atalaphysicaltherapy.com
# Optional: also POST every lead as JSON to Zapier / Make / Google Apps Script
LEAD_WEBHOOK_URL=

# ── Tracking (defaults are the IDs from the WordPress site) ───────────
# NEXT_PUBLIC_GTM_IDS=GTM-MJR3WK7S,GTM-T6RNMD9F
# NEXT_PUBLIC_GTAG_IDS=GT-5NGCTGN,AW-11547202367
# Set to 1 to disable all tracking (useful locally)
# NEXT_PUBLIC_DISABLE_TRACKING=1
